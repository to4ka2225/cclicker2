:import from_hex kivy.utils.get_color_from_hex
:import colormap kivy.utils.colormap


:set main_color "#F3AF12"
:set main_color_dark "#F37C12"
# ДОДАНО: кольори двох тем. Їх можна змінити тут, не редагуючи Python-код.
#:set light_background "#FFF5F5"
#:set light_text "#4A4A4A"
#:set light_button "#F7D6D0"
#:set light_button_pressed "#E2B4BD"
#:set dark_background "#19183B"
#:set dark_text "#E7F2EF"
#:set dark_button "#708993"
#:set dark_button_pressed "#A1C2BD"


# Спільний стиль кнопок меню
<ButtonMenu@Button>:
    font_size: "20sp"
    size_hint: 1, 0.15
    background_normal: ''
    # ДОДАНО: кольори кнопки залежать від вибраної теми.
    background_color: from_hex(light_button) if app.theme == "light" else from_hex(dark_button)
    color: from_hex(light_text) if app.theme == "light" else from_hex(dark_text)
    on_press:
        # ДОДАНО: колір кнопки під час натискання для обох тем.
        self.background_color = from_hex(light_button_pressed) if app.theme == "light" else from_hex(dark_button_pressed)
    on_release:
        # ДОДАНО: повернення кольору й звук після натискання кнопки.
        self.background_color = from_hex(light_button) if app.theme == "light" else from_hex(dark_button)
        app.play_button_sound()

<Widget>:
     font_name: 'assets/fonts/PlayfairDisplay-Italic-VariableFont_wght.ttf'

<Screen>:
    canvas.before:
        Color:
            rgba: from_hex(light_background) if app.theme == "light" else from_hex(dark_button)
        Rectangle:
            pos: self.pos
            size: self.size

<Label>:
    color: from_hex(light_text) if app.theme == "light" else from_hex(dark_text)

<MenuScreen>:

    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "20dp"

        Image:
            source: "img.png"
            size_hint: 1, 0.5

        Label:
            text: "Main Menu"
            font_size: "40sp"
            size_hint: 1, 0.2

        ButtonMenu:
            text: "PLAY"
            on_press: root.go_game()

        ButtonMenu:
            text: "SETTINGS"
            on_press: root.go_settings()

        ButtonMenu:
            text: "EXIT"
            on_press: root.exit_app()


<GameScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "20dp"

        Label:
            text: "Game Screen"
            font_size: "40sp"

        Label:
            text: "Очки: " + str(root.score)
            font_size: "30sp"
            size_hint: 1,0.2

        Fish:
            id: fish
            size_hint: 1,0.65


        ButtonMenu:
            text: "Back to Menu"
            on_press: root.go_menu()

        Label:
            id: Level_complete
            text: "LEVEL COMPLEATE!"
            font_size: "35sp"
            color: 0,1,0,1
            opacity: 0

<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "20dp"

        Label:
            text: "Settings"
            font_size: "40sp"

        ButtonMenu:
            text: "Back to Menu"
            on_press: root.go_menu()

        ButtonMenu:
            text: "lIGHT THEME"
            on_press: app.set_theme("light")

        ButtonMenu:
            text: "DARK THEME"
            on_press: app.set_theme("dark")

        ButtonMenu:
            text: "MUSIC 1"
            on_press: app.play_music("")

        ButtonMenu:
            text: "MUSIC 2"
            on_press: app.play_music("")